{
  "name": "takapp",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @takapp/web dev",
    "dev:bot": "pnpm --filter @takapp/bot dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @takapp/web db:generate",
    "db:migrate": "pnpm --filter @takapp/web db:migrate",
    "deploy": "pnpm -r deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "unrs-resolver"]
  }
}
