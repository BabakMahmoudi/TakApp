# pnpm settings
strict-peer-dependencies=false
auto-install-peers=true
prefer-offline=true
# Real-directory node_modules: Next.js standalone output (OpenNext build) cannot
# recreate pnpm's store symlinks on stock Windows (EPERM without Developer Mode).
node-linker=hoisted

# Local HTTP proxy for registry fetches (flaky direct network)
proxy=http://localhost:2352
https-proxy=http://localhost:2352

# Flaky-network hardening: registry fetches retry before failing
fetch-retries=10
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=20000
fetch-timeout=30000
network-concurrency=6
