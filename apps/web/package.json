    "@stellar/stellar-sdk": "^15.0.0",
    "@takapp/shared": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "drizzle-orm": "^0.45.0",
    "jose": "^6.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
